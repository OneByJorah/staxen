# ═══════════════════════════════════════════════════════
# staxen — Environment Variables
# Copy to .env and change the defaults before production use.
# ═══════════════════════════════════════════════════════

# ── Server Identity ────────────────────────────────────
SERVER_IP=localhost

# ── Landing Page ────────────────────────────────────────
SVC_STAXEN_PORT=8085

# ── SearXNG (optional — only with --profile full) ──────
SVC_SEARXNG_PORT=8080
SEARXNG_SECRET_KEY=change-me-in-production

# ── Qdrant ─────────────────────────────────────────────
SVC_QDRANT_PORT=6333

# ── Honcho (Memory) ────────────────────────────────────
SVC_HONCHO_PORT=8000
SVC_HONCHO_DB_PORT=5432
SVC_HONCHO_REDIS_PORT=6379
HONCHO_DB_PASSWORD=changeme
HONCHO_TOKEN=changeme

# ── Honcho LLM Provider (optional) ─────────────────────
# See .env.honcho.example for full configuration
# Honcho needs an OpenAI-compatible provider for LLM features
# LLM_VLLM_API_KEY=
# LLM_VLLM_BASE_URL=https://openrouter.ai/api/v1

# ── CouchDB (Obsidian LiveSync) ────────────────────────
SVC_COUCHDB_PORT=5984
COUCHDB_ADMIN_USER=admin
COUCHDB_ADMIN_PASSWORD=changeme
COUCHDB_SYNC_USER=obsync
COUCHDB_SYNC_PASSWORD=changeme

# ── Syncthing (P2P file sync — optional) ─────────────
SVC_SYNCTHING_UI_PORT=8384

# ── Selenium Web Automation (optional) ───────────────────
SVC_SELENIUM_PORT=4444
SELENIUM_SHM_SIZE=2g
SELENIUM_NO_SANDBOX=1
SELENIUM_VNC_PASSWORD=

# ── Ollama (local LLM — optional) ────────────────────────
OLLAMA_HOST=http://ollama:11434
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1

# ── Obsidian Vault Web Viewer ──────────────────────────
SVC_OBSIDIAN_PORT=8083

# ── Obsidian Vault host path ───────────────────────────
# Path on host where Hermes agents write notes
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault
